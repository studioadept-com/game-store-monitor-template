{
  "apple": {"enabled": true, "monitor_builds": true, "release_notes": true},
  "google": {
    "enabled": true,
    "monitor_builds": true,
    "discover_apps": true,
    "lifecycle_quota_cooldown_seconds": 3600,
    "lifecycle_max_requests": 6,
    "lifecycle_window_seconds": 120,
    "lifecycle_active_interval_seconds": 900,
    "lifecycle_idle_interval_seconds": 21600,
    "lifecycle_request_spacing_seconds": 2,
    "apps": {},
    "extra_tracks": ["production", "beta", "alpha", "internal"]
  },
  "telegram": {
    "enabled": false,
    "exclude_apps": []
  },
  "discord": {
    "enabled": false,
    "exclude_apps": [],
    "events": {
      "apple": ["waiting_for_review", "in_review", "published"],
      "google": ["published", "rollout_changed", "rollout_paused", "rollout_resumed", "rollout_completed"],
      "monitor": []
    },
    "google_tracks": ["production"]
  },
  "batch_window_seconds": 600,
  "failure_threshold": 3,
  "notification_timezone": "UTC"
}
